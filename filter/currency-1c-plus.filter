#===============================================================================================================
# POE2 Filter — Currency 1c+, Max-Socket Bases & Unique Rings
# Shows Stackable Currency orbs worth >= 1 Chaos, all Gold, all boss/encounter access consumables (fragments, keys, logbooks), any item with max (3) rune sockets, all unique rings, and rings/amulets at unidentified tier 5+. Hides everything else.
# Prices: poe2scout, Runes of Aldur, 2026-07-03 (1 Chaos = 101.67 ex, 1 Divine = 7.23c).
# Snapshot-gated: re-run /lootfilter to refresh as prices move.
#===============================================================================================================

#===============================================================================================================
# [[0100]] S-tier orbs (>1000c) — Mirror, Hinekora's Lock
#===============================================================================================================

Show # %D6 $type->currency $tier->stier !cur_stier
    Class == "Stackable Currency"
    BaseType == "Mirror of Kalandra" "Hinekora's Lock"
    SetFontSize 45
    SetTextColor 255 255 255 255
    SetBorderColor 220 50 50 255
    SetBackgroundColor 70 0 0 255
    PlayEffect Red
    MinimapIcon 0 Red Star
    PlayAlertSound 6 300

#===============================================================================================================
# [[0200]] A-tier orbs (10-100c) — Perfect Chaos, Fracturing, Perfect Exalted
#===============================================================================================================

Show # %D5 $type->currency $tier->atier !cur_atier
    Class == "Stackable Currency"
    BaseType == "Perfect Chaos Orb" "Fracturing Orb" "Perfect Exalted Orb"
    SetFontSize 42
    SetTextColor 255 255 255 255
    SetBorderColor 200 100 30 255
    SetBackgroundColor 55 25 0 255
    PlayEffect Orange
    MinimapIcon 1 Orange Diamond
    PlayAlertSound 2 280

#===============================================================================================================
# [[0300]] B-tier orbs (1-10c) — Divine, Annulment, Greater Chaos, Perfect Jeweller's, Chaos
#===============================================================================================================

Show # %D4 $type->currency $tier->btier !cur_btier
    Class == "Stackable Currency"
    BaseType == "Divine Orb" "Orb of Annulment" "Greater Chaos Orb" "Perfect Jeweller's Orb" "Chaos Orb"
    SetFontSize 40
    SetTextColor 255 255 255 255
    SetBorderColor 210 200 60 255
    SetBackgroundColor 45 40 0 255
    PlayEffect Yellow
    MinimapIcon 1 Yellow Circle
    PlayAlertSound 1 250

#===============================================================================================================
# [[0500]] Exceptional bases — any item with max (3) rune sockets
#===============================================================================================================

Show # %D4 $type->gear $tier->maxsocket !gear_maxsocket
    Sockets >= 3
    SetFontSize 40
    SetTextColor 255 255 255 255
    SetBorderColor 30 150 190 255
    SetBackgroundColor 0 30 45 255
    PlayEffect Cyan
    MinimapIcon 1 Cyan Square
    PlayAlertSound 3 260

#===============================================================================================================
# [[0600]] Unique rings — every unique ring, any base
#===============================================================================================================

Show # %D4 $type->unique $tier->unique_ring !unique_ring
    Class == "Rings"
    Rarity == Unique
    SetFontSize 40
    SetTextColor 255 255 255 255
    SetBorderColor 175 96 37 255
    SetBackgroundColor 45 25 0 255
    PlayEffect Brown
    MinimapIcon 1 Brown Moon
    PlayAlertSound 3 260

#===============================================================================================================
# [[0700]] Gold — show every stack, any size (needed to farm gold)
#===============================================================================================================

Show # %D3 $type->gold $tier->all !gold_all
    Class == "Stackable Currency"
    BaseType == "Gold"
    SetFontSize 36
    SetTextColor 255 200 60 255
    SetBorderColor 120 90 20 255
    SetBackgroundColor 30 22 0 255

#===============================================================================================================
# [[0400]] Boss / encounter access consumables — fragments, pinnacle & vault keys, logbooks
#===============================================================================================================

Show # %D5 $type->fragments $tier->boss !boss_access
    Class == "Map Fragments" "Pinnacle Keys" "Vault Keys" "Expedition Logbook"
    SetFontSize 42
    SetTextColor 255 255 255 255
    SetBorderColor 60 180 120 255
    SetBackgroundColor 0 40 25 255
    PlayEffect Green
    MinimapIcon 1 Green Pentagon
    PlayAlertSound 4 280

#===============================================================================================================
# [[0800]] Rings & Amulets — unidentified tier 5+ (top-tier rare jewellery)
#===============================================================================================================

Show # %D4 $type->jewellery $tier->unid_t5 !jewel_unid_t5
    Class == "Rings" "Amulets"
    UnidentifiedItemTier >= 5
    SetFontSize 40
    SetTextColor 255 255 255 255
    SetBorderColor 200 60 200 255
    SetBackgroundColor 35 0 40 255
    PlayEffect Purple
    MinimapIcon 1 Purple Kite
    PlayAlertSound 3 260

#===============================================================================================================
# [[0900]] Hide everything else
#===============================================================================================================

Hide # %H5 $type->hidelayer $tier->everything !hide_all
    DisableDropSound True
